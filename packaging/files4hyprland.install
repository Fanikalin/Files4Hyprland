post_install() {
  echo ":: Run 'files4hyprland-setup --all' as your user to make Files the default folder handler,"
  echo "   add SUPER+SHIFT+F and use it as the file-chooser dialog."
}

post_upgrade() {
  echo ":: Files4Hyprland updated. Re-run 'files4hyprland-setup --all' only if its settings changed."
}

pre_remove() {
  # Undo the per-user settings that files4hyprland-setup added (they are marked).
  for h in /home/*; do
    [ -d "$h" ] || continue
    u=$(stat -c %U "$h" 2>/dev/null) || continue
    runuser -u "$u" -- env HOME="$h" files4hyprland-setup --undo --quiet >/dev/null 2>&1 || true
  done
}
