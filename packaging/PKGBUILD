# Maintainer: Fanikalin
pkgname=files4hyprland
pkgver=1.2.0
pkgrel=1
pkgdesc='Mouse-friendly TUI file manager for Hyprland/Omarchy: sidebar, tabs, system file chooser'
arch=('any')
url='https://github.com/Fanikalin/Files4Hyprland'
license=('MIT')
depends=('python' 'python-textual' 'glib2' 'udisks2' 'xdg-utils')
optdepends=(
  'xdg-desktop-portal-termfilechooser: use as the system "choose a file" dialog (AUR)'
  'ttf-jetbrains-mono-nerd: icons'
)
install=files4hyprland.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('9776b76bd7d175b990d3484c20d257e96080d0c4051cf454a45510152e2b5684')

package() {
  cd "Files4Hyprland-$pkgver"
  install -Dm644 files.py "$pkgdir/usr/lib/files4hyprland/files.py"
  install -Dm755 bin/files-tui "$pkgdir/usr/bin/files-tui"
  install -Dm755 bin/files4hyprland-open "$pkgdir/usr/bin/files4hyprland-open"
  install -Dm755 bin/files4hyprland-setup "$pkgdir/usr/bin/files4hyprland-setup"
  install -Dm644 desktop/files4hyprland.desktop "$pkgdir/usr/share/applications/files4hyprland.desktop"
  install -Dm755 portal/files-tui-wrapper.sh "$pkgdir/usr/share/files4hyprland/portal/files-tui-wrapper.sh"
  install -Dm644 portal/config.in "$pkgdir/usr/share/files4hyprland/portal/config.in"
  install -Dm644 portal/hyprland-portals.conf "$pkgdir/usr/share/files4hyprland/portal/hyprland-portals.conf"
  install -Dm644 hypr/bindings.lua "$pkgdir/usr/share/files4hyprland/hypr/bindings.lua"
  install -Dm644 hypr/looknfeel.lua "$pkgdir/usr/share/files4hyprland/hypr/looknfeel.lua"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
