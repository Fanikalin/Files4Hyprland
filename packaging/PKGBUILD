# Maintainer: Fanikalin
pkgname=files4hyprland
pkgver=2.4.0
pkgrel=1
pkgdesc='Light native (GTK4/C) file manager for Hyprland/Omarchy: sidebar, tabs, system drag and drop'
arch=('x86_64' 'aarch64')
url='https://github.com/Fanikalin/Files4Hyprland'
license=('MIT')
depends=('gtk4' 'glib2' 'gvfs' 'udisks2' 'xdg-utils')
makedepends=('meson' 'gcc' 'pkgconf')
optdepends=(
  'xdg-desktop-portal-termfilechooser: use as the system "choose a file" dialog (AUR)'
  'xdg-terminal-exec: "Open terminal here"'
  'ttf-jetbrains-mono-nerd: icons'
)
options=('!debug')
install=files4hyprland.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('6fcfbbc09b4f7e8b456a869716dda6c6447efec47fcdc297185ae60a26913f4a')

build() {
  arch-meson "Files4Hyprland-$pkgver" build
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm644 "Files4Hyprland-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "Files4Hyprland-$pkgver/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
