#!/bin/sh
# Open Files4Hyprland in a terminal window (Omarchy styling when available).
if command -v omarchy-launch-tui >/dev/null 2>&1; then
  exec omarchy-launch-tui files-tui "$@"
elif command -v xdg-terminal-exec >/dev/null 2>&1; then
  exec xdg-terminal-exec --app-id=org.omarchy.files-tui -e files-tui "$@"
else
  exec "${TERMINAL:-xterm}" -e files-tui "$@"
fi
