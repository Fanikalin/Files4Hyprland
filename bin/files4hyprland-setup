#!/usr/bin/env bash
# Per-user integration for Files4Hyprland. Everything it adds is marked and can be undone.
#   --default  make it the default folder handler
#   --hypr     add SUPER+SHIFT+F bindings and a floating rule (Omarchy/Hyprland)
#   --portal   use it as the system "choose a file" dialog (needs xdg-desktop-portal-termfilechooser)
#   --all      all of the above
#   --undo     remove everything this script added
#   --refresh  re-apply only what is already enabled (used on package upgrade)
set -euo pipefail

SHARE=/usr/share/files4hyprland
BEGIN="-- >>> files4hyprland"
END="-- <<< files4hyprland"
H="$HOME/.config/hypr"
P="$HOME/.config/xdg-desktop-portal-termfilechooser"
desk="$(echo "${XDG_CURRENT_DESKTOP:-Hyprland}" | cut -d: -f1 | tr '[:upper:]' '[:lower:]')"
PC="$HOME/.config/xdg-desktop-portal/${desk}-portals.conf"
MIME="$HOME/.config/mimeapps.list"

DEFAULT=0; HYPR=0; PORTAL=0; UNDO=0; QUIET=0; REFRESH=0
for a in "$@"; do
  case "$a" in
    --default) DEFAULT=1 ;; --hypr) HYPR=1 ;; --portal) PORTAL=1 ;;
    --all) DEFAULT=1; HYPR=1; PORTAL=1 ;; --undo) UNDO=1 ;; --quiet) QUIET=1 ;; --refresh) REFRESH=1 ;;
    -h|--help) sed -n '2,9p' "$0"; exit 0 ;;
    *) echo "unknown option: $a" >&2; exit 2 ;;
  esac
done
[ $((DEFAULT+HYPR+PORTAL+UNDO+REFRESH)) -gt 0 ] || { sed -n '2,9p' "$0"; exit 1; }
say() { [ "$QUIET" = 1 ] || echo "$@"; }

add_block() {  # file snippet (replaces an older block)
  del_block "$1"
  mkdir -p "$(dirname "$1")"
  { echo; echo "$BEGIN"; cat "$2"; echo "$END"; } >> "$1"
}
del_block() {  # file
  [ -f "$1" ] && grep -qF -- "$BEGIN" "$1" && sed -i "\#^$BEGIN#,\#^$END#d" "$1" || true
}
owned() { [ -f "$1" ] && grep -q '^# files4hyprland' "$1"; }

if [ "$UNDO" = 1 ]; then
  del_block "$H/bindings.lua"; del_block "$H/looknfeel.lua"
  owned "$P/config" && rm -f "$P/config" "$P/files4hyprland-wrapper.sh" "$P/files-tui-wrapper.sh"
  owned "$PC" && rm -f "$PC"
  if [ -f "$MIME" ] && grep -q '^inode/directory=files4hyprland.desktop' "$MIME"; then
    sed -i '/^inode\/directory=files4hyprland.desktop/d' "$MIME"
  fi
  hyprctl reload >/dev/null 2>&1 || true
  systemctl --user try-restart xdg-desktop-portal xdg-desktop-portal-termfilechooser >/dev/null 2>&1 || true
  say "Files4Hyprland user settings removed."
  exit 0
fi

if [ "$REFRESH" = 1 ]; then
  grep -qF -- "$BEGIN" "$H/bindings.lua" 2>/dev/null && HYPR=1
  owned "$P/config" && PORTAL=1
  grep -q '^inode/directory=files4hyprland.desktop' "$MIME" 2>/dev/null && DEFAULT=1
fi

if [ "$DEFAULT" = 1 ]; then
  xdg-mime default files4hyprland.desktop inode/directory
  say "Default folder handler: Files."
fi

if [ "$HYPR" = 1 ]; then
  add_block "$H/bindings.lua" "$SHARE/hypr/bindings.lua"
  add_block "$H/looknfeel.lua" "$SHARE/hypr/looknfeel.lua"
  hyprctl reload >/dev/null 2>&1 || true
  say "Hyprland: SUPER+SHIFT+F opens Files."
fi

if [ "$PORTAL" = 1 ]; then
  command -v xdg-desktop-portal-termfilechooser >/dev/null 2>&1 || \
    [ -x /usr/lib/xdg-desktop-portal-termfilechooser ] || \
    say "Note: install xdg-desktop-portal-termfilechooser (AUR) for this to take effect."
  mkdir -p "$P" "$(dirname "$PC")"
  rm -f "$P/files-tui-wrapper.sh"  # left by 1.x
  install -m755 "$SHARE/portal/files4hyprland-wrapper.sh" "$P/files4hyprland-wrapper.sh"
  sed "s|@WRAPPER@|$P/files4hyprland-wrapper.sh|" "$SHARE/portal/config.in" > "$P/config"
  install -m644 "$SHARE/portal/hyprland-portals.conf" "$PC"
  systemctl --user restart xdg-desktop-portal xdg-desktop-portal-termfilechooser >/dev/null 2>&1 || true
  say "File chooser portal configured."
fi
