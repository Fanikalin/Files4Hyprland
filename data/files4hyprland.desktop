[Desktop Entry]
Type=Application
Version=1.0
Name=Files
GenericName=File Manager
Comment=Light file manager for Hyprland
Exec=files4hyprland %U
Icon=system-file-manager
Terminal=false
StartupNotify=true
StartupWMClass=io.github.fanikalin.Files4Hyprland
Categories=Utility;Core;System;FileTools;FileManager;GTK;
Keywords=files;file manager;explorer;folder;directory;файлы;проводник;папки;
MimeType=inode/directory;
